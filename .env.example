# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Buffer API (multi-channel publishing)
BUFFER_ACCESS_TOKEN=...
BUFFER_PROFILE_IDS=instagram_id,tiktok_id,pinterest_id,reels_id

# Social Media Direct APIs (optional, for native posting)
INSTAGRAM_ACCESS_TOKEN=...
INSTAGRAM_BUSINESS_ACCOUNT_ID=...

TIKTOK_ACCESS_TOKEN=...
TIKTOK_BUSINESS_ACCOUNT_ID=...

PINTEREST_ACCESS_TOKEN=...
PINTEREST_BUSINESS_ACCOUNT_ID=...

# Database
DATABASE_URL=file:./data/trendib.db

# Affiliate tracking
AFFILIATE_BASE_URL=https://trendib.com/register
AFFILIATE_TRACKING_SECRET=your-secret-key-here

# App config
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
